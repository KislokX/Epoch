{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EpochServices",
  "version": "0.1.0",
  "identifier": "com.epoch.services",
  "build": {
    "devUrl": "http://127.0.0.1:11499",
    "frontendDist": "http://127.0.0.1:11499"
  },
  "app": {
    "windows": [
      {
        "title": "EpochServices",
        "width": 980,
        "height": 820,
        "minWidth": 520,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' http://127.0.0.1:11499",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'none'",
        "img-src": "'self' data:",
        "connect-src": "'self' http://127.0.0.1:11499",
        "object-src": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
